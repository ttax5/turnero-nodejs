# Copiar este archivo a .env y completar los valores (el .env no se sube al repositorio)

# Puerto del servidor HTTP
PORT=8080

# Entorno de ejecución: development | production
NODE_ENV=development

# URI de conexión a MongoDB Atlas (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/booking_system
